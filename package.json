{
  "name": "bughaw-calculators-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:access": "vitest run --config vitest.integration.config.ts",
    "db:types": "npx --yes supabase@2.109.1 gen types typescript --local --schema public > src/lib/supabase/types.ts",
    "vercel-build": "npm run test:coverage && next build",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke --project=chromium",
    "e2e:perf": "CI=true playwright test --grep @perf --project=chromium --reporter=list",
    "e2e:ui": "playwright test --ui",
    "e2e:db": "supabase start && supabase db reset && ./scripts/e2e/env.sh",
    "e2e:clean": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e/clean.ts",
    "e2e:visual:update": "docker run --rm --network host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test --project=visual --update-snapshots",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^1.41.0",
    "next": "^16.4.6",
    "passkit-generator": "^3.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
