# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base URL used in digital-card links/QR codes. Must be https:// to take
# effect; otherwise the browser/request origin is used.
# NEXT_PUBLIC_SITE_URL=https://suite.bughawinnovations.ph

# --- Digital card wallet passes (OPTIONAL, server-only secrets) -------------
# Leave unset to hide the wallet buttons. Never prefix these with NEXT_PUBLIC_.
# PEM values: paste with literal \n for newlines. See docs/digital-cards.md §6.
# APPLE_PASS_TYPE_ID=pass.ph.bughawinnovations.card
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_PEM=
# APPLE_PASS_KEY_PEM=
# APPLE_PASS_KEY_PASSPHRASE=
# APPLE_WWDR_CERT_PEM=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
